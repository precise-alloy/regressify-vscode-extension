{
  "name": "regressify",
  "displayName": "Regressify",
  "description": "Visual Automation Test Tool",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.120.0"
  },
  "publisher": "tuyen",
  "categories": [
    "Other"
  ],
  "license": "ISC",
  "activationEvents": [
    "workspaceContains:visual_tests/*.tests.yaml",
    "workspaceContains:visual_tests/*.tests.yml",
    "workspaceContains:visual_tests/*.tests.json"
  ],
  "icon": "assets/logo.png",
  "main": "./dist/extension.js",
  "galleryBanner": {
    "color": "#ffe04b"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/precise-alloy/regressify-vscode-extension.git"
  },
  "author": "tuyen-at-work",
  "contributes": {
    "commands": [
      {
        "command": "regressify.helloWorld",
        "title": "✅ Regressify - 0. Hello World"
      },
      {
        "command": "regressify.open",
        "title": "✅ Regressify - 1. Open"
      },
      {
        "command": "regressify.reference",
        "title": "✅ Regressify - 2. Reference"
      },
      {
        "command": "regressify.approve",
        "title": "✅ Regressify - 3. Approve"
      },
      {
        "command": "regressify.runTest",
        "title": "✅ Regressify - 4. Run Test"
      },
      {
        "command": "regressify.test",
        "title": "✅ Regressify - 4. Test"
      },
      {
        "command": "regressify.viewReport",
        "title": "✅ Regressify - 5. View Report"
      },
      {
        "command": "regressify.refreshVisualTests",
        "title": "✅ Regressify - 6. Refresh"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "regressify.open",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.reference",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.approve",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.test",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.viewReport",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "regressify.reference",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.approve",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.test",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        },
        {
          "command": "regressify.viewReport",
          "when": "resourceFilename =~ /.tests\\.(yaml|yml|json)$/ && resourceDirname =~ /visual_tests/",
          "group": "navigation@1"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "regressifyExplorer",
          "name": "Regressify",
          "icon": "assets/logo.png"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.1.0",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.12.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}